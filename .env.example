# Copy to .env. Replace blank values locally; never commit the resulting file.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
POSTGRES_DB=lexflow
POSTGRES_USER=lexflow
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# This user must be allowed to create test databases locally (Compose does this).
POSTGRES_TEST_DB=test_lexflow
# Development-only seed login password; 12+ characters. No default is supplied.
LEXFLOW_DEMO_PASSWORD=
# Deployment additionally requires explicit HTTPS origins, e.g. https://firm.example
DJANGO_CSRF_TRUSTED_ORIGINS=
# Deployment: use an absolute persistent directory outside the public web root.
# DJANGO_PRIVATE_MEDIA_ROOT=/srv/lexflow/private-media
# Deployment DB TLS: set require/verify-full as appropriate for your provider.
# POSTGRES_SSLMODE=require
# Deployment password recovery via SMTP. Local development writes to .dev-email/.
# DJANGO_EMAIL_HOST=smtp.example
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USE_TLS=true
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_DEFAULT_FROM_EMAIL=accounts@example
